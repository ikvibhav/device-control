@startuml nfi_device_control

title Wafer Measurement using Measuring Device and Positioning Unit

skinparam linetype ortho


class Vector2D {
  + x_um: float
  + y_um: float
  + __add__(other: Vector2D) : Vector2D
  + __sub__(other: Vector2D) : Vector2D
  + magnitude() : float
  + angle_degrees() : float
  + __repr__() : str
}


class MeasuringDevice {
    - nominal_offset: Vector2D
    + set_calibration_offset(offset: Vector2D) : void
    + get_calibration_offset() : Vector2D
    + get_actual_position() : Vector2D
    + calibration_measurement() : Vector2D
    + measure_2d() : Vector2D
    + measure_mark() : Vector2D
}


class PositioningUnit {
    + move_pu(target_x_um: float, target_y_um: float) : void
    + get_pu_position() : Vector2D
    + get_md_position() : Vector2D
}


class Wafer {
    + get_shot_position(mark_x: int, mark_y: int) : Vector2D
    + get_mark_position(mark_x: int, mark_y: int) : Vector2D
    + rotate_point(point: Vector2D, angle_degrees: float) : Vector2D
    + wafer_cs_to_pu_cs(point_wafer_cs: Vector2D) : Vector2D
}


class CalibrationStation {
    + get_location() : Vector2D
}


class DeviceController {
    + perform_calibration() : void
    + determine_wafer_position_rotation(): void
    + measure_center_mark() : Vector2D
    + measure_offset_mark() : Vector2D
}


MeasuringDevice ..> Vector2D : uses
PositioningUnit ..> Vector2D : uses
PositioningUnit --o MeasuringDevice : contains

CalibrationStation ..> Vector2D : uses
Wafer ..> Vector2D : uses


DeviceController --> PositioningUnit : uses
DeviceController --> Wafer : uses
DeviceController ..> CalibrationStation : uses

@enduml
